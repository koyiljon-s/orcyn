# Local config for orcyn-api.
#   cp crates/orcyn-api/.env.example crates/orcyn-api/.env
# .env is ignored by git. On Kubernetes these come from a ConfigMap/Secret instead.

DATABASE_URL=postgres://orcyn:orcyn@localhost:5433/orcyn
ORCYN_API_PORT=8080
RUST_LOG=orcyn_api=debug,tower_http=info

# Shared secret for workers. Generate a real one with: openssl rand -hex 32
ORCYN_WORKER_TOKEN=dev-worker-token-change-me

# Optional (defaults shown)
# ORCYN_STORAGE_DIR=crates/orcyn-api/data/artifacts
# ORCYN_MAX_UPLOAD_MB=64
# ORCYN_LEASE_SECS=60
# ORCYN_MAX_ATTEMPTS=3
# ORCYN_REAPER_INTERVAL_SECS=10
