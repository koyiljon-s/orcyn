# Local config for orcyn-worker.
#   cp crates/orcyn-worker/.env.example crates/orcyn-worker/.env
# Any value can also be passed as a flag, e.g. --prover cpu (run with --help).

ORCYN_WORKER_API_URL=http://localhost:8080
# Must match ORCYN_WORKER_TOKEN in crates/orcyn-api/.env
ORCYN_WORKER_TOKEN=dev-worker-token-change-me
ORCYN_WORKER_ID=local-1
# mock: instant fake proofs (development) | cpu: real proofs | cuda: GPU (Linux + NVIDIA only)
ORCYN_WORKER_PROVER=mock

# SP1 logs a lot at info level; keep it quieter than ours.
RUST_LOG=orcyn_worker=info,sp1_sdk=warn,sp1_core_machine=warn,sp1_prover=warn

# Optional (defaults shown)
# ORCYN_WORKER_POLL_SECS=2
# ORCYN_WORKER_HEARTBEAT_SECS=10
