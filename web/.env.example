# Copy to .env.local for local development:  cp .env.example .env.local
# NEXT_PUBLIC_ values are baked into the JavaScript at build time,
# so set them in your hosting provider's environment before building.

# Waitlist form endpoint (e.g. a Formspree form: https://formspree.io/f/<form-id>).
# The form POSTs JSON {"email": "..."} with Accept: application/json.
# Leave empty and the form shows "not configured" instead of losing sign-ups.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Optional contact address shown in the footer and as a form fallback.
NEXT_PUBLIC_CONTACT_EMAIL=
